<resources>
    <style name="Theme.OpenScribe" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#0B0F17</item>
        <item name="android:navigationBarColor">#0B0F17</item>
        <item name="android:windowBackground">#0B0F17</item>
    </style>

    <style name="Theme.OpenScribe.TranslucentDialog" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>
</resources>
