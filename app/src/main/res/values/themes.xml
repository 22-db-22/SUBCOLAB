<resources>
    <style name="Theme.OpenScribe" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#FAF7F0</item>
        <item name="android:navigationBarColor">#FAF7F0</item>
        <item name="android:windowBackground">#FAF7F0</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.OpenScribe.TranslucentDialog" parent="android:Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>
</resources>
